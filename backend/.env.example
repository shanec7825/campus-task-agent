# 后端环境变量示例 —— 仅占位值，仓库中不得提交真实 Key（R8-AC1）
# 复制为 .env 后按需修改：cp .env.example .env

# MaaS（OpenAI 兼容）凭证；留空或 MAAS_MOCK=1 时进入离线 mock 模式
MAAS_API_KEY=your-maas-api-key
MAAS_BASE_URL=https://your-maas-endpoint.example.com/v1
MAAS_MODEL=DeepSeek-V4.1-Flash-1017
MAAS_MOCK=1

# SQLite 数据库文件路径（相对 backend/ 工作目录）
DATABASE_PATH=./campus.db

# 0 = 不启动 APScheduler 催办调度器（自动化验收用）
RUN_SCHEDULER=1

# SSE 心跳间隔（秒）与催办扫描间隔（秒）
SSE_HEARTBEAT_SECONDS=15
REMINDER_INTERVAL_SECONDS=60

# 允许跨域的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173